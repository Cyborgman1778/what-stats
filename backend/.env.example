# Runtime
ENVIRONMENT=production
DEBUG=false
ENABLE_DOCS=false

# Server
HOST=127.0.0.1
PORT=8000

# Public access
# Add only the frontend/app origins allowed to call the API from browsers/WebViews.
# CORS is not authentication; keep Cloudflare/WAF/rate limits enabled in production.
ALLOWED_ORIGINS=https://localhost
CORS_ALLOW_CREDENTIALS=false

# Host header validation
# Include the public API host and any local hosts used by Docker/proxies/health checks.
TRUSTED_HOSTS=api.whatstats.net,www.whatstats.net,whatstats.net,localhost,127.0.0.1

# Upload limits, in bytes
MAX_UPLOAD_SIZE=52428800
MAX_DECOMPRESSED_SIZE=52428800
MAX_ZIP_COMPRESSION_RATIO=100

# Abuse protection
RATE_LIMIT_PER_MINUTE=3
